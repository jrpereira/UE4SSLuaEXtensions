#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @BRIDGE_BOOTSTRAP_VERSION_MAJOR@,@BRIDGE_BOOTSTRAP_VERSION_MINOR@,@BRIDGE_BOOTSTRAP_VERSION_PATCH@,0
 PRODUCTVERSION @BRIDGE_BOOTSTRAP_VERSION_MAJOR@,@BRIDGE_BOOTSTRAP_VERSION_MINOR@,@BRIDGE_BOOTSTRAP_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@BRIDGE_BOOTSTRAP_DISPLAY_NAME@ contributors\0"
            VALUE "FileDescription", "@BRIDGE_BOOTSTRAP_DISPLAY_NAME@ bootstrap\0"
            VALUE "FileVersion", "@BRIDGE_BOOTSTRAP_VERSION@.0\0"
            VALUE "InternalName", "@BRIDGE_BOOTSTRAP_TARGET@\0"
            VALUE "OriginalFilename", "main.dll\0"
            VALUE "ProductName", "@BRIDGE_BOOTSTRAP_PRODUCT@ Bootstrap\0"
            VALUE "ProductVersion", "@BRIDGE_BOOTSTRAP_VERSION@\0"
            VALUE "BridgeRole", "Bootstrap\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
