# mod_settings.ini from a product's mod.json. The menu rows live in mod.json
# as an ordered "settings" array; Dawnwalker Mod Menu (and ModCore Settings
# through it) still reads mod_settings.ini, so the build writes that file.
#
#   lex_mod_settings_text(<out_var> <mod.json path>)
#   lex_write_mod_settings(<mod.json path> <mod_settings.ini path>)
#
# mod.json:
#   "id", "name"          become [Mod] Id and Name
#   "settings": [ {...} ] one [Setting.<Id>] section per entry, in array order
# Each entry holds the Dawnwalker Mod Menu keys (Id, Type, Label, ...). A value
# is a string or a number; an array (PresetValues, PresetLabels) is joined with
# "|". Keys are written in the usual order (Id, Type, Label, Description,
# Group, PresetValues, PresetLabels, Default, ConfigFile, ConfigSection,
# ConfigKey), any others after them in name order. Works in script mode too.

set(_LEX_SETTING_KEY_ORDER Id Type Label Description Group PresetValues PresetLabels Default
    ConfigFile ConfigSection ConfigKey)

function(_lex_setting_value out_var entry key where)
    string(JSON kind TYPE "${entry}" "${key}")
    if(kind STREQUAL "STRING" OR kind STREQUAL "NUMBER")
        string(JSON value GET "${entry}" "${key}")
    elseif(kind STREQUAL "ARRAY")
        string(JSON count LENGTH "${entry}" "${key}")
        set(value "")
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE ${last})
                string(JSON item_kind TYPE "${entry}" "${key}" ${index})
                if(NOT (item_kind STREQUAL "STRING" OR item_kind STREQUAL "NUMBER"))
                    message(FATAL_ERROR "${where}: ${key}[${index}] must be a string or a number")
                endif()
                string(JSON item GET "${entry}" "${key}" ${index})
                if(item MATCHES "[|]")
                    message(FATAL_ERROR "${where}: ${key}[${index}] can't hold |")
                endif()
                if(index GREATER 0)
                    string(APPEND value "|")
                endif()
                string(APPEND value "${item}")
            endforeach()
        endif()
    else()
        message(FATAL_ERROR "${where}: ${key} must be a string, a number or an array")
    endif()
    if(value MATCHES "[\r\n]")
        message(FATAL_ERROR "${where}: ${key} can't hold a line break")
    endif()
    set(${out_var} "${value}" PARENT_SCOPE)
endfunction()

function(lex_mod_settings_text out_var manifest)
    file(READ "${manifest}" json)
    string(JSON id GET "${json}" id)
    string(JSON name GET "${json}" name)
    set(text "[Mod]\nId=${id}\nName=${name}\n")
    string(JSON settings_kind ERROR_VARIABLE missing TYPE "${json}" settings)
    if(missing)
        set(count 0)
    elseif(NOT settings_kind STREQUAL "ARRAY")
        message(FATAL_ERROR "${manifest}: settings must be an array")
    else()
        string(JSON count LENGTH "${json}" settings)
    endif()
    set(seen "")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            set(where "${manifest}: settings[${index}]")
            string(JSON entry_kind TYPE "${json}" settings ${index})
            if(NOT entry_kind STREQUAL "OBJECT")
                message(FATAL_ERROR "${where} must be an object")
            endif()
            string(JSON entry GET "${json}" settings ${index})
            string(JSON setting_kind ERROR_VARIABLE no_id TYPE "${entry}" Id)
            if(no_id OR NOT setting_kind STREQUAL "STRING")
                message(FATAL_ERROR "${where} needs a string Id")
            endif()
            string(JSON setting GET "${entry}" Id)
            if(NOT setting MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
                message(FATAL_ERROR "${where}: Id ${setting} must be a letter, then letters, digits or _")
            endif()
            if(setting IN_LIST seen)
                message(FATAL_ERROR "${where}: Id ${setting} is repeated")
            endif()
            list(APPEND seen "${setting}")

            string(JSON size LENGTH "${entry}")
            math(EXPR last_key "${size} - 1")
            set(keys "")
            foreach(key_index RANGE ${last_key})
                string(JSON key MEMBER "${entry}" ${key_index})
                if(NOT key MATCHES "^[A-Za-z][A-Za-z0-9]*$")
                    message(FATAL_ERROR "${where}: key ${key} must be letters and digits")
                endif()
                list(APPEND keys "${key}")
            endforeach()
            set(ordered "")
            foreach(key IN LISTS _LEX_SETTING_KEY_ORDER)
                if(key IN_LIST keys)
                    list(APPEND ordered "${key}")
                    list(REMOVE_ITEM keys "${key}")
                endif()
            endforeach()
            list(SORT keys)
            list(APPEND ordered ${keys})

            string(APPEND text "\n[Setting.${setting}]\n")
            foreach(key IN LISTS ordered)
                _lex_setting_value(value "${entry}" "${key}" "${where}")
                string(APPEND text "${key}=${value}\n")
            endforeach()
        endforeach()
    endif()
    set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

# Writes only when the text changed, so an unchanged mod.json doesn't rebuild.
function(lex_write_mod_settings manifest output)
    lex_mod_settings_text(text "${manifest}")
    set(current "")
    if(EXISTS "${output}")
        file(READ "${output}" current)
    endif()
    if(NOT current STREQUAL text)
        file(WRITE "${output}" "${text}")
    endif()
endfunction()
