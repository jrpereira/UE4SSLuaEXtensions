# mod_settings.ini from a product's mod.json. The menu rows live in mod.json
# as an ordered "settings" array; Dawnwalker Mod Menu (and ModCore Settings
# through it) still reads mod_settings.ini, so the build writes that file.
#
#   lex_mod_settings_text(<out_var> <mod.json path>)
#   lex_write_mod_settings(<mod.json path> <mod_settings.ini path>)
#
# mod.json:
#   "id", "name"          become [Mod] Id and Name
#   "settings": [ {...} ] one [Setting.<id>] section per row, in array order
#
# A row:
#   "id"           required: a letter, then letters, digits or _
#   "type", "label", "description", "group", "default"
#   "values"       [[value, label], ...]: PresetValues and PresetLabels
#   "file"         where the value is stored; default "config.ini"
#   "section"      default: the mod.json id
#   "key"          default: the row's id
# A value is a string or a number. Any other field is refused. Works in script
# mode too.

set(_LEX_SETTING_FIELDS id type label description group default values file section key)

# A string or number field of `json` at the given path, refused otherwise.
function(_lex_setting_scalar out_var json where)
    string(JSON kind TYPE "${json}" ${ARGN})
    if(NOT (kind STREQUAL "STRING" OR kind STREQUAL "NUMBER"))
        message(FATAL_ERROR "${where} must be a string or a number")
    endif()
    string(JSON value GET "${json}" ${ARGN})
    if(value MATCHES "[\r\n]")
        message(FATAL_ERROR "${where} can't hold a line break")
    endif()
    set(${out_var} "${value}" PARENT_SCOPE)
endfunction()

function(lex_mod_settings_text out_var manifest)
    file(READ "${manifest}" json)
    string(JSON mod_id GET "${json}" id)
    string(JSON mod_name GET "${json}" name)
    set(text "[Mod]\nId=${mod_id}\nName=${mod_name}\n")
    string(JSON settings_kind ERROR_VARIABLE missing TYPE "${json}" settings)
    if(missing)
        set(count 0)
    elseif(NOT settings_kind STREQUAL "ARRAY")
        message(FATAL_ERROR "${manifest}: settings must be an array")
    else()
        string(JSON count LENGTH "${json}" settings)
    endif()
    set(seen "")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            set(where "${manifest}: settings[${index}]")
            string(JSON row_kind TYPE "${json}" settings ${index})
            if(NOT row_kind STREQUAL "OBJECT")
                message(FATAL_ERROR "${where} must be an object")
            endif()
            string(JSON row GET "${json}" settings ${index})

            string(JSON size LENGTH "${row}")
            math(EXPR last_field "${size} - 1")
            set(fields "")
            foreach(field_index RANGE ${last_field})
                string(JSON field MEMBER "${row}" ${field_index})
                if(NOT field IN_LIST _LEX_SETTING_FIELDS)
                    message(FATAL_ERROR "${where}: unknown field ${field}")
                endif()
                list(APPEND fields "${field}")
            endforeach()

            if(NOT "id" IN_LIST fields)
                message(FATAL_ERROR "${where} needs an id")
            endif()
            _lex_setting_scalar(id "${row}" "${where}.id" id)
            if(NOT id MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
                message(FATAL_ERROR "${where}: id ${id} must be a letter, then letters, digits or _")
            endif()
            if(id IN_LIST seen)
                message(FATAL_ERROR "${where}: id ${id} is repeated")
            endif()
            list(APPEND seen "${id}")

            set(lines "Id=${id}\n")
            foreach(pair "type;Type" "label;Label" "description;Description" "group;Group")
                list(GET pair 0 field)
                list(GET pair 1 name)
                if(field IN_LIST fields)
                    _lex_setting_scalar(value "${row}" "${where}.${field}" ${field})
                    string(APPEND lines "${name}=${value}\n")
                endif()
            endforeach()

            if("values" IN_LIST fields)
                string(JSON values_kind TYPE "${row}" values)
                if(NOT values_kind STREQUAL "ARRAY")
                    message(FATAL_ERROR "${where}.values must be an array of [value, label] pairs")
                endif()
                string(JSON values_count LENGTH "${row}" values)
                set(preset_values "")
                set(preset_labels "")
                if(values_count GREATER 0)
                    math(EXPR last_value "${values_count} - 1")
                    foreach(value_index RANGE ${last_value})
                        set(at "${where}.values[${value_index}]")
                        string(JSON pair_kind TYPE "${row}" values ${value_index})
                        if(pair_kind STREQUAL "ARRAY")
                            string(JSON pair_length LENGTH "${row}" values ${value_index})
                        endif()
                        if(NOT pair_kind STREQUAL "ARRAY" OR NOT pair_length EQUAL 2)
                            message(FATAL_ERROR "${at} must be a [value, label] pair")
                        endif()
                        _lex_setting_scalar(value "${row}" "${at}[0]" values ${value_index} 0)
                        _lex_setting_scalar(label "${row}" "${at}[1]" values ${value_index} 1)
                        if(value MATCHES "[|]" OR label MATCHES "[|]")
                            message(FATAL_ERROR "${at} can't hold |")
                        endif()
                        if(value_index GREATER 0)
                            string(APPEND preset_values "|")
                            string(APPEND preset_labels "|")
                        endif()
                        string(APPEND preset_values "${value}")
                        string(APPEND preset_labels "${label}")
                    endforeach()
                endif()
                string(APPEND lines "PresetValues=${preset_values}\nPresetLabels=${preset_labels}\n")
            endif()

            if("default" IN_LIST fields)
                _lex_setting_scalar(value "${row}" "${where}.default" default)
                string(APPEND lines "Default=${value}\n")
            endif()

            set(file "config.ini")
            set(section "${mod_id}")
            set(key "${id}")
            foreach(field file section key)
                if(field IN_LIST fields)
                    _lex_setting_scalar(${field} "${row}" "${where}.${field}" ${field})
                endif()
            endforeach()
            string(APPEND lines "ConfigFile=${file}\nConfigSection=${section}\nConfigKey=${key}\n")

            string(APPEND text "\n[Setting.${id}]\n${lines}")
        endforeach()
    endif()
    set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

# Writes only when the text changed, so an unchanged mod.json doesn't rebuild.
function(lex_write_mod_settings manifest output)
    lex_mod_settings_text(text "${manifest}")
    set(current "")
    if(EXISTS "${output}")
        file(READ "${output}" current)
    endif()
    if(NOT current STREQUAL text)
        file(WRITE "${output}" "${text}")
    endif()
endfunction()
